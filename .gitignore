# ==========================================
# LogoSculpt - Git Ignore Rules
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Scratch & Temporary Testing
scratch/
tmp/
temp/
*.log

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs & Code Editors
.idea/
.vscode/
*.swp
*.swo

# User Workspace (Drop zone & batch outputs)
# Keep directory structure via .gitkeep
input/*
!input/.gitkeep
output/*
!output/.gitkeep

# Package builds
dist/
build/
*.egg-info/
